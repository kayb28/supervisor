<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Visible para poder detectar si Shizuku está instalado (Android 11+) -->
    <queries>
        <package android:name="moe.shizuku.privileged.api" />
    </queries>

    <!--
      Permisos de métricas: el estetoscopio necesita que le dejen mirar.
      PACKAGE_USAGE_STATS es un permiso especial: no se pide con un
      diálogo, se otorga con un interruptor en Ajustes (la app te lleva
      hasta él) o por ADB con «appops». QUERY_ALL_PACKAGES y READ_LOGS
      se declaran aquí; este último solo se puede conceder vía ADB.
    -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <uses-permission
        android:name="android.permission.READ_LOGS"
        tools:ignore="ProtectedPermissions" />

    <application
        android:label="@string/app_name"
        android:icon="@android:drawable/sym_def_app_icon"
        android:theme="@style/Theme.Supervisor"
        android:allowBackup="false">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- El monitor con pulso: CPU, GPU, RAM y disco en vivo -->
        <activity
            android:name=".PanelEnVivo"
            android:exported="false"
            android:label="Panel en tiempo real" />

        <!-- Proveedor estándar de Shizuku: canal oficial hacia el sistema -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
    </application>
</manifest>
